{
  "manifest_version": 3,
  "name": "AI Studio Pro Suite",
  "version": "1.3.7",
  "description": "Curated sampling presets and precision controls for Google AI Studio.",
  "host_permissions": ["https://aistudio.google.com/*"],
  "content_scripts": [
    {
      "matches": ["https://aistudio.google.com/*"],
      "css": ["styles.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://aistudio.google.com/*"],
      "js": ["extension.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
